{
  "name": "ascolto-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android and iOS apps for ASCOLTO (CILS A2 exam simulator). Wraps the web build in ../cils-app so web, Android and iOS ship the same app.",
  "type": "module",
  "scripts": {
    "web:prepare": "node scripts/prepare-web.mjs",
    "sync": "npm run web:prepare && cap sync",
    "sync:android": "npm run web:prepare && cap sync android",
    "sync:ios": "npm run web:prepare && cap sync ios",
    "android:debug": "npm run sync:android && node scripts/gradle.mjs assembleDebug",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android --ios --iconBackgroundColor \"#1e6b4f\" --iconBackgroundColorDark \"#1e6b4f\" --splashBackgroundColor \"#f7f4ec\" --splashBackgroundColorDark \"#13241b\"",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "check": "node scripts/check-parity.mjs",
    "test": "node test/bridge.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "esbuild": "^0.28.2"
  }
}
